#!/bin/sh
# home-deploy — dispatcher de deploy (forced-command de la clave DEPLOY_SSH_KEY).
# Gestionado por Ansible (rol deploy_ssh) — no editar a mano.
#
# El runner de Forgejo invoca:  ssh deploy@host <app> o <app>@sha256:<digest>
# El nombre <app> llega en $SSH_ORIGINAL_COMMAND (el forced-command ignora el resto).
# <app> es el nombre del service/unit (convención de la casa: guión_bajo, ej. nd_market),
# que puede diferir del nombre del repo/imagen (ej. repo nd.market -> unit nd_market).
# Solo se aceptan apps con una unit de usuario gestionada, para no permitir pulls/restarts
# arbitrarios aunque se filtre la clave.
set -eu

# systemctl --user necesita el runtime dir del usuario; bajo un forced-command puede no
# venir seteado.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

command=$(printf '%s' "${SSH_ORIGINAL_COMMAND:-}" | tr -d '\r\n')
app="$command"
ref=""
case "$command" in
  *@sha256:*)
    app=${command%@*}
    ref=${command#*@}
    ;;
esac

# Nombres válidos = nombre de unit systemd: minúsculas, dígitos, guión y guión_bajo.
case "$app" in
  '' | *[!a-z0-9_-]*)
    echo "home-deploy: nombre de app inválido: '${app}'" >&2
    exit 2
    ;;
esac

{% for immutable_app, immutable_image in deploy_ssh_immutable_images.items() %}
if [ "$app" = "{{ immutable_app }}" ]; then
  case "$ref" in
    sha256:*)
      digest=${ref#sha256:}
      case "$digest" in
        '' | *[!0-9a-fA-F]*)
          echo "home-deploy: digest inválido para '${app}'" >&2
          exit 2
          ;;
      esac
      digest_length=$(printf '%s' "$digest" | wc -c)
      if [ "$digest_length" -ne 64 ]; then
        echo "home-deploy: digest inválido para '${app}'" >&2
        exit 2
      fi
      ;;
    *)
      echo "home-deploy: '${app}' requiere un digest sha256" >&2
      exit 2
      ;;
  esac
fi
{% endfor %}

unit="${app}.service"
if ! systemctl --user cat "$unit" >/dev/null 2>&1; then
  echo "home-deploy: app desconocida (sin unit gestionada): '${app}'" >&2
  exit 3
fi

{% for immutable_app, immutable_image in deploy_ssh_immutable_images.items() %}
if [ "$app" = "{{ immutable_app }}" ]; then
  image="{{ immutable_image }}"
  echo "home-deploy: pulling ${image}@${ref}"
  podman pull "${image}@${ref}"
  podman tag "${image}@${ref}" "${image}:latest"
else
{% endfor %}
  # Para apps sin política de digest se conserva el flujo legacy de Quadlet.
  :
{% for immutable_app, immutable_image in deploy_ssh_immutable_images.items() %}
fi
{% endfor %}
echo "home-deploy: restarting ${unit}"
systemctl --user restart "$unit"

echo "home-deploy: ${app} OK"
