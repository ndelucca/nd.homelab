# {{ ansible_managed }}
# PostgreSQL {{ postgres_major }} — instancia compartida ({{ postgres_domain }}).
# Se carga con `postgres -c config_file=...`; el postgresql.conf que deja initdb dentro
# de PGDATA no se usa.

# --- Conexiones -------------------------------------------------------------------
# Network=host: esto ES la frontera de red (junto con pg_hba y el firewall).
listen_addresses = '{{ postgres_host }},{{ postgres_lan_host }}'
port = {{ postgres_port }}
max_connections = {{ postgres_max_connections }}

# --- Autenticación y TLS ------------------------------------------------------------
hba_file = '/etc/postgresql/pg_hba.conf'
password_encryption = scram-sha-256
ssl = on
ssl_cert_file = '/etc/postgresql/tls/server.crt'
ssl_key_file = '/etc/postgresql/tls/server.key'
ssl_min_protocol_version = 'TLSv1.2'

# --- Memoria ------------------------------------------------------------------------
shared_buffers = {{ postgres_shared_buffers_mb }}MB
effective_cache_size = {{ postgres_effective_cache_size_mb }}MB
work_mem = {{ postgres_work_mem_mb }}MB
maintenance_work_mem = {{ postgres_maintenance_work_mem_mb }}MB

# --- Disco (NVMe) -------------------------------------------------------------------
random_page_cost = 1.1
effective_io_concurrency = 200
max_wal_size = {{ postgres_max_wal_size }}
wal_compression = on

# --- Observabilidad -----------------------------------------------------------------
# Los logs van a stderr -> journald (`journalctl --user -u {{ postgres_service_name }}`).
shared_preload_libraries = 'pg_stat_statements'
log_line_prefix = '%m [%p] %q%u@%d '
log_min_duration_statement = {{ postgres_log_min_duration_ms }}
log_checkpoints = on
log_lock_waits = on
log_temp_files = 10MB
log_autovacuum_min_duration = 10s
log_timezone = '{{ postgres_timezone }}'
timezone = '{{ postgres_timezone }}'

{% if postgres_extra_settings %}
# --- Extra (postgres_extra_settings) ------------------------------------------------
{% for key, value in postgres_extra_settings | dictsort %}
{{ key }} = {{ value }}
{% endfor %}
{% endif %}
