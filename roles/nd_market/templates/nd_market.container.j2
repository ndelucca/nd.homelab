[Unit]
Description=nd_market Container
# La app habla con el PostgreSQL compartido (postgres.service, otra user unit de este mismo
# usuario). After= ordena el arranque; no es Requires= a proposito: un reinicio de postgres
# no tiene que tirar nd_market, que reconecta sola. Si postgres todavia no esta, la app falla
# al arrancar y Restart=on-failure la vuelve a intentar.
After=network-online.target postgres.service
Wants=network-online.target

[Container]
Image={{ nd_market_image }}
ContainerName={{ nd_market_container_name }}

UserNS=keep-id:uid={{ nd_market_uid }},gid={{ nd_market_uid }}

# Red del host, como postgres y forgejo-runner, y NO la red rootless por defecto: con pasta
# el contenedor recibe la MISMA IP que el host, asi que 192.168.10.10:5432 (el Postgres
# compartido) es el propio contenedor y da "connection refused". Esto ya paso: el primer
# deploy con Postgres quedo en loop de reinicio sin poder conectar. Con la red del host la
# app escucha ella misma en loopback (NDM_ADDR), que es donde NGINX la busca.
Network=host
Environment=NDM_ADDR={{ nd_market_host }}:{{ nd_market_port }}

# /data ya no tiene la base (vive en el PostgreSQL compartido); queda para el perfil del
# consultor (perfil.md) y lo que la app quiera persistir fuera de la base.
Volume={{ nd_market_data_dir }}:/data:Z

# NDM_DB_URL, con la password adentro. Va por EnvironmentFile y no por Environment= porque
# este archivo es 0644 y lo lee cualquiera; el .env es 0600 del usuario. Es la UNICA variable
# sin la que la app no arranca.
EnvironmentFile={{ nd_market_secrets_dir }}/nd_market.env
{% if nd_market_claude_bridge_enabled %}

# Bridge del CLI de Claude (rol claude_bridge). Sin `:z` ni `:Z`: el dir ya viene etiquetado
# container_file_t, y `:Z` (MCS privado) se lo robaría a las demás apps que comparten el socket.
Volume={{ nd_market_claude_socket_dir }}:{{ nd_market_claude_mount }}
Environment=NDM_CLAUDE_PROVIDER=bridge
Environment=NDM_CLAUDE_SOCKET={{ nd_market_claude_mount }}/sock
{% endif %}

# El dispatcher de deploy trae el digest publicado y lo etiqueta como :latest antes de
# reiniciar; Pull=newer conserva la recuperación automática si la unit arranca por fuera
# del flujo de Forgejo.
Pull=newer

[Service]
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target default.target
