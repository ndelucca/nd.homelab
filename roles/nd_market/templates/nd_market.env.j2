# {{ ansible_managed }}
# NDM_DB_URL de nd_market: la base compartida del rol postgres. Lo carga la unit con
# EnvironmentFile=; el contenedor no monta este archivo.
NDM_DB_URL=postgres://{{ nd_market_db_user }}:{{ nd_market_db_password | urlencode }}@{{ nd_market_db_host }}:{{ nd_market_db_port }}/{{ nd_market_db_name }}?sslmode={{ nd_market_db_sslmode }}
