---
# ansible-lint configuration for the home-server project.
#
# Perfil `production` (el más estricto). Se subió desde `moderate` cuando el backlog
# que lo justificaba quedó cerrado, para que el gate defienda el nivel alcanzado en
# vez de permitir que una regresión lo baje sin aviso.

profile: production

exclude_paths:
  - .ansible/
  - .github/
  - vendor/  # Mitogen vendorizado (código de terceros)
  - collections/  # colecciones instaladas por ansible-galaxy (código de terceros)

skip_list:
  # yamllint ya reporta las líneas largas como warning (max 160, ver .yamllint).
  # Duplicarlo acá como error sólo forzaría cortes artificiales en args de módulo.
  - yaml[line-length]

# Warnings, no errores. Cada entrada corresponde a una decisión deliberada; si el
# caso que la justifica desaparece, sacala de acá.
warn_list:
  # Los pocos `command` sin changed_when son instaladores con `creates:` o comandos
  # que el módulo nativo no cubre (lego issue, el uninstaller propio de AdGuard).
  - no-changed-when
  # `os_update` hace `dnf upgrade` a propósito: es un rol de actualización del SO,
  # no un converge de configuración.
  - package-latest
  # roles/adguard/tasks/systemd-resolved.yml: el backup de resolv.conf copia el
  # archivo original preservando sus permisos, y el wait_for del puerto 53 usa
  # ignore_errors porque en estado estable AdGuard ya lo tiene tomado.
  - risky-file-permissions
  - ignore-errors
